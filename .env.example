# Среда приложения. local — текстовые логи, dev/prod — JSON.
APP_ENV=local

# Подключение к PostgreSQL внутри Docker Compose.
DATABASE_URL=postgres://ris:ris@postgres:5432/ris?sslmode=disable

# Источники для демонстраций.
SOURCE_URL=https://api.nobelprize.org/v1/laureate.json
JSON_FILE=/app/examples/laureates.json

# Файл внутри контейнера. На компьютере он находится в Практики/logs/ris.log.
LOG_PATH=/app/logs/ris.log

# Таймаут HTTP-загрузки и время завершения приложения.
HTTP_TIMEOUT=30s
SHUTDOWN_TIMEOUT=5s
